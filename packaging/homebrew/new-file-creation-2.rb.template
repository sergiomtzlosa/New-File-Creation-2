cask "new-file-creation-2" do
  version "@@VERSION@@"
  sha256 "@@SHA256@@"

  url "@@URL@@"
  name "New File Creation 2"
  desc "Create files from templates in Finder, the menu bar, and the command line"
  homepage "@@HOMEPAGE@@"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "New File Creation 2.app"
  binary "#{appdir}/New File Creation 2.app/Contents/Helpers/nfc", target: "nfc"

  uninstall quit: "com.sid.newfilecreation2"

  zap trash: [
    "~/Library/Application Support/New File Creation 2",
    "~/Library/Caches/com.sid.newfilecreation2",
    "~/Library/Preferences/com.sid.newfilecreation2.plist",
  ]

  caveats <<~EOS
    Open New File Creation 2 once, then enable "New File Creation 2 Finder"
    in System Settings > General > Login Items & Extensions > Finder Extensions.
    The nfc command-line tool is linked into Homebrew's bin directory.
  EOS
end
